<?xml version="1.0" encoding="utf-8"?>
<configuration>

	<connectionStrings>
		<add name="SkillSwapDB"
			 connectionString="Data Source=(LocalDB)\MSSQLLocalDB;Initial Catalog=SkillSwapAcademy;Integrated Security=True"
			 providerName="System.Data.SqlClient"/>
	</connectionStrings>

	<appSettings>
		<add key="ValidationSettings:UnobtrusiveValidationMode" value="None"/>
	</appSettings>

	<system.web>
		<compilation debug="true" targetFramework="4.7.2"/>
		<httpRuntime targetFramework="4.7.2" maxRequestLength="10240"/>
		<pages controlRenderingCompatibilityVersion="4.0"
			   clientIDMode="AutoID"/>
	</system.web>

	<system.webServer>
		<defaultDocument>
			<files>
				<clear/>
				<add value="LandingPage.aspx"/>
			</files>
		</defaultDocument>
	</system.webServer>

</configuration>